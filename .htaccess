Options -Indexes
RewriteEngine On

# ============================================================
# SÉCURITÉ — Forcer HTTPS (redirection 301)
# Le test sur X-Forwarded-Proto couvre le cas d'un proxy/load-balancer
# OVH qui termine le TLS en amont et transmet en HTTP en interne.
# ============================================================
RewriteCond %{HTTPS} off
RewriteCond %{HTTP:X-Forwarded-Proto} !https
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# ============================================================
# SÉCURITÉ — Bloquer accès direct aux répertoires et fichiers internes
# ============================================================
RewriteRule ^(app|core|config|vendor|database|storage|tests|dev|docs)(/|$) - [F,L]
RewriteRule ^(bootstrap\.php|composer\.(json|lock)|README\.md)$ - [F,L]
# Fichiers cachés (.git, .env…), sauf .well-known (validation des certificats)
RewriteRule (^|/)\.(?!well-known/) - [F,L]

# ============================================================
# REDIRECTIONS 301 — Anciennes URLs (avant migration MVC)
# ============================================================
RewriteRule ^connexion\.php$                    /connexion                   [R=301,L]
RewriteRule ^inscription\.php$                  /inscription                 [R=301,L]
RewriteRule ^calendar\.php$                     /calendrier                  [R=301,L]
RewriteRule ^contact\.php$                      /contact                     [R=301,L]
RewriteRule ^logout\.php$                       /deconnexion                 [R=301,L]
RewriteRule ^confirm\.php$                      /confirmation                [R=301,L]
RewriteRule ^mention_legales\.php$              /mentions-legales            [R=301,L]
RewriteRule ^politique_de_confidentialite\.php$ /politique-confidentialite   [R=301,L]
RewriteRule ^mot_de_passe_oublier\.php$         /mot-de-passe-oublie         [R=301,L]
RewriteRule ^send_reminders\.php$               /cron/send_reminders.php     [R=301,L]
RewriteRule ^delete_past_events\.php$           /cron/delete_past_events.php [R=301,L]

# ============================================================
# PASS-THROUGH — Fichiers et dossiers existants (assets, cron, etc.)
# ============================================================
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# ============================================================
# FRONT CONTROLLER — Toutes les autres requêtes
# ============================================================
RewriteRule ^ index.php [L]

# ============================================================
# EN-TÊTES DE SÉCURITÉ
# ============================================================
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"

    # HSTS — indique aux navigateurs de toujours utiliser HTTPS sur ce domaine
    # (et ses sous-domaines) pendant 1 an, même si l'utilisateur tape http://
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"

    # Content-Security-Policy — limite les origines autorisées pour les scripts,
    # styles, polices, images, etc. Aucun script inline n'est exécuté : tout le
    # JavaScript est dans assets/js (les blocs JSON-LD / application/json ne sont
    # pas exécutés et ne sont donc pas concernés). 'unsafe-inline' reste autorisé
    # pour les styles uniquement (styles injectés par le widget reCAPTCHA).
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self' https://www.google.com https://www.gstatic.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://cdnjs.cloudflare.com; font-src 'self' https://fonts.gstatic.com https://cdnjs.cloudflare.com; img-src 'self' data: https:; connect-src 'self'; frame-src https://www.google.com; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'"

    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"

    # X-XSS-Protection est obsolète : ignoré par les navigateurs modernes et a pu
    # introduire des vulnérabilités via le filtre XSS de certains anciens
    # navigateurs (XSSAuditor). La CSP ci-dessus le remplace avantageusement.
</IfModule>

# ============================================================
# PERFORMANCES
# ============================================================
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css               "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
    ExpiresByType image/png              "access plus 6 months"
    ExpiresByType image/webp             "access plus 6 months"
    ExpiresByType image/svg+xml          "access plus 6 months"
    ExpiresByType image/x-icon           "access plus 1 year"
</IfModule>

<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css application/javascript text/plain
</IfModule>
